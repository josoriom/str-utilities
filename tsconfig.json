{
    "compilerOptions": {
        "module": "ES2022",
        "moduleResolution": "Node",
        "ignoreDeprecations": "6.0",
        "outDir": "lib",
        "sourceMap": true,
        "strict": false,
        "target": "ES2022",
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true
    },
    "include": [
        "./src/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}